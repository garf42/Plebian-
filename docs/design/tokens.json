{
  "color": {
    "dawn": "#848DB3",
    "slate": "#5D739B",
    "steel": "#49637C",
    "teal": "#3B555A",
    "forest": "#2D4839",
    "ground_gradient": { "angle_deg": 125, "stops": [["#848DB3", 0], ["#5D739B", 0.30], ["#49637C", 0.55], ["#3B555A", 0.78], ["#2D4839", 1.0]] },
    "screen_background": { "angle_deg": 170, "stops": [["#E8EBF1", 0], ["#E5EBE8", 1.0]] },
    "ink": "#1E2A2D",
    "ink_2": "#47555A",
    "ink_3": "#7C878A",
    "ink_4": "#A9B1B2",
    "paper": "#FBFAF6",
    "paper_2": "#F3F1EA",
    "paper_3": "#E9E6DD",
    "rule": "#DCD8CD",
    "rule_2": "#C9C4B6",
    "ore": "#B9772E",
    "ore_2": "#E7C9A2",
    "ore_tint": "#FBF3E8",
    "ok": "#3E7A55",
    "warn": "#A4552F",
    "card": "rgba(252,251,248,0.90)",
    "heard_under": "rgba(237,241,240,0.95)",
    "roles": {
      "owner_bubble": "steel",
      "action": "forest",
      "tap": "ore",
      "heard_speaker": "teal",
      "presence": ["dawn", "steel", "forest"]
    }
  },
  "type": {
    "display": { "family": "Vollkorn", "style": "italic", "weight": 600, "use": "names, dates, titles; paired to the wordmark's Monarcha SemiBold Italic" },
    "body": { "family": "Atkinson Hyperlegible Next", "weights": [400, 500, 600, 700], "use": "reading" },
    "mono": { "family": "Atkinson Hyperlegible Mono", "weights": [400, 500], "use": "times, counts, kickers" },
    "license": "SIL Open Font License 1.1 (all three); bundled with the app",
    "sizes_px": { "day_name": 21, "title": 19, "body": 14, "line": 13.5, "meta": 10.5, "kicker": 9.5 }
  },
  "shape": {
    "card_radius": 14,
    "card_shadow": ["0 1px 2px rgba(30,42,45,.06)", "0 6px 18px rgba(30,42,45,.06)"],
    "owner_bubble_radius": "16 16 4 16",
    "chip_radius": 99,
    "heard_rule": "1px dashed ink_4, 6px period",
    "settled_rule": "solid, ink"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "touch_feedback_ms": [180, 320],
    "reduced_motion": "every animation becomes a 150 ms fade",
    "lay": { "ms": 340, "from": { "translateY_px": 16, "rotate_deg": -0.7, "scale": 0.988, "blur_px": 1.2, "opacity": 0 }, "to": "identity", "means": "a new page is laid over the last" },
    "out": { "ms": 200, "to": { "translateY_px": -6, "scale": 0.995, "opacity": 0 } },
    "strike": { "ms": 620, "keyframes": [[0, { "translateY_px": -9, "opacity": 0 }], [1, "identity"]], "means": "a tap's dot drops onto the ribbon" },
    "live": { "bar_ms": 500, "stagger_ms": 30, "transform_origin": "bottom", "means": "the ribbon fills as the day is heard" },
    "peek": { "ms": 420, "to": { "translateY": "100% - 46px", "rotate_deg": 0.6 }, "means": "lift the page to see the heard day" },
    "presence": { "ms": 1400, "loop": "linear", "means": "the agent is working" },
    "settle": { "ms": 450, "means": "the dashed rule inks solid after the owner answers" },
    "badge_bump": { "ms": 400, "peak_scale": 1.35 },
    "omi_chip_pulse": { "ms": 1300, "means": "syncing" },
    "stream_word_stagger_ms": 45
  },
  "haptics_omi": { "short_ms": 100, "long_ms": 500, "levels": { "1": 100, "2": 300, "3": 500 } },
  "glyphs": {
    "tap": "a filled circle, 7 px across (the same dot as list bullets), color ore; on the ribbon it sits at the tap's minute above the bars; spoken label \"tapped\"",
    "wordmark": "docs/design/wordmark.png (576x169, white on transparent; place on the ground gradient)"
  }
}
